---
// PostHog for storefront pages (plan 06): the official web snippet, loaded only when both vars are
// set. It must stay is:inline. Privacy options keep personal data out (AGENTS.md): no element
// attributes in autocapture, masked inputs and no network bodies or headers in replay, emails
// redacted from exception text. Helpers and the event catalog live in src/scripts/analytics.ts.
import { PUBLIC_POSTHOG_HOST, PUBLIC_POSTHOG_PROJECT_TOKEN } from 'astro:env/client';
---
<script is:inline define:vars={{ token: PUBLIC_POSTHOG_PROJECT_TOKEN, host: PUBLIC_POSTHOG_HOST, dev: import.meta.env.DEV, environment: import.meta.env.MODE }}>
  const missing = !token ? 'PUBLIC_POSTHOG_PROJECT_TOKEN' : !host ? 'PUBLIC_POSTHOG_HOST' : '';
  if (missing) {
    if (dev) throw new Error(missing + ' variable required by PostHog is missing or un-configured, this causes events to be silently missed. This error stops appearing once ' + missing + ' is configured');
  } else {
    // POSTHOG_BROWSER_SNIPPET_START
    !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],Object.defineProperty(u,"toString",{configurable:!0,enumerable:!0,writable:!0,value:function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e}}),Object.defineProperty(u.people,"toString",{configurable:!0,enumerable:!0,writable:!0,value:function(){return u.toString(1)+".people (stub)"}}),o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagResult reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys getNextSurveyStep onSessionId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
    // POSTHOG_BROWSER_SNIPPET_END
    const EMAIL = /[^\s@<>"']+@[^\s@<>"']+\.[^\s@<>"']+/g;
    posthog.init(token, {
      api_host: host,
      defaults: '2026-08-30',
      capture_exceptions: {
        capture_unhandled_errors: true,
        capture_unhandled_rejections: true,
        capture_console_errors: false,
      },
      logs: {
        serviceName: 'kix-web',
        environment,
      },
      mask_all_element_attributes: true,
      session_recording: { maskAllInputs: true, recordBody: false, recordHeaders: false },
      before_send: (event) => {
        if (event && event.event === '$exception') {
          (event.properties.$exception_list || []).forEach((item) => {
            if (typeof item.value === 'string') item.value = item.value.replace(EMAIL, '[email]');
          });
        }
        return event;
      },
      loaded: (instance) => window.__kixPosthogReady?.(instance),
    });
  }
</script>
