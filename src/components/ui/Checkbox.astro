---
import { Check } from '@lucide/astro';
interface Props {
  id: string;
  required?: boolean;
  className?: string;
}
const { id, required = false, className = '' } = Astro.props;
const errorId = `${id}-error`;
---
<div class:list={['ui-checkbox', className]}>
  <label class="ui-checkbox__row">
    <input class="ui-checkbox__input" type="checkbox" id={id} name={id} required={required} aria-describedby={errorId} />
    <span class="ui-checkbox__box" aria-hidden="true"><Check /></span>
    <span class="ui-checkbox__label"><slot /></span>
  </label>
  <p class="ui-field-error" id={errorId} hidden data-field-error></p>
</div>
