---
import { Eye, EyeOff } from '@lucide/astro';
import TextField from './TextField.astro';
interface Props {
  id: string;
  label: string;
  placeholder: string;
  autocomplete: 'current-password' | 'new-password';
  labelVisible?: boolean;
  minlength?: number;
  className?: string;
}
const { id, label, placeholder, autocomplete, labelVisible = false, minlength, className = '' } = Astro.props;
---
<TextField id={id} label={label} placeholder={placeholder} type="password" autocomplete={autocomplete} labelVisible={labelVisible} minlength={minlength} required size="lg" errors className={className}>
  <!-- One fixed name; aria-pressed carries the state, so it never announces "Hide password, pressed". -->
  <button class="ui-password-toggle" type="button" slot="trailing" aria-label="Show password" aria-pressed="false" aria-controls={id} data-password-toggle>
    <Eye class="ui-password-toggle__show" aria-hidden="true" />
    <EyeOff class="ui-password-toggle__hide" aria-hidden="true" />
  </button>
</TextField>
