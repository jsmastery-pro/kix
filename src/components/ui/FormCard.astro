---
interface Props {
  title: string;
  className?: string;
}
const { title, className = '' } = Astro.props;
const titleId = `${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-title`;
---
<section class:list={['ui-form-card', className]} aria-labelledby={titleId}>
  <h1 class="ui-form-card__title" id={titleId}>{title}</h1>
  <slot />
</section>
