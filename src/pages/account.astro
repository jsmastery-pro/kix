---
// Account: the signed-in member's profile, a name form, a password reset link and sign out
// (plan 05). Read on the server as the member; a visitor goes to sign in. Replaces the kit's
// React shell (AccountPage/RequireAuth), which stays in src/components/members/ unused. Saved Designs
// (plan 12) are read here as the member; Delete runs in the browser (saved-designs.ts).
import { Trash2 } from '@lucide/astro';
import Avatar from '../components/ui/Avatar.astro';
import Button from '../components/ui/Button.astro';
import FormAlert from '../components/ui/FormAlert.astro';
import FormCard from '../components/ui/FormCard.astro';
import TextField from '../components/ui/TextField.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { logoutAction } from '../scripts/return-to';
import { fetchCurrentMember } from '../wix/members/members';
import { listDesigns, type SavedDesign } from '../wix/models/designs';
import { paletteName } from '../wix/models/palette';
import { ZONES } from '../wix/models/presets';

Astro.response.headers.set('Cache-Control', 'private, no-store');
const member = await fetchCurrentMember();
if (!member) return Astro.redirect('/login?returnTo=%2Faccount');

// One sub-request; a failure shows its message and is reported from the browser (no analytics here).
let designs: SavedDesign[] = [];
let designsFailed = false;
try {
  designs = await listDesigns(member.id, { limit: 50 });
} catch (error) {
  designsFailed = true;
  console.error('[account] saved designs read failed', error);
}
// UTC here; saved-designs.ts rewrites each <time> in the shopper's time zone, as the product page shows it.
const savedDate = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const zoneLabel = { upper: 'upper', sole: 'sole', laces: 'laces', accent: 'accent' } as const;
const colorsOf = (design: SavedDesign) => ZONES.filter((z) => design.zones[z]).map((z) => ({ zone: z, hex: design.zones[z]! }));
const describe = (design: SavedDesign) => colorsOf(design).map(({ zone, hex }) => `${zoneLabel[zone]} ${paletteName(hex)?.toLowerCase() ?? 'original'}`).join(', ');

// memberSince is "YYYY-MM-DD" (UTC); format in UTC so the 1st doesn't become the month before.
const memberSince = member.memberSince
  ? new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${member.memberSince}T00:00:00Z`))
  : '';
---

<SiteLayout title="Account · Kix" description="Your Kix account.">
  <div class="account" data-account data-member-id={member.id} data-login-email={member.loginEmail}>
    <div class="account__head">
      <Avatar name={member.displayName} photoUrl={member.photoUrl} size="lg" className="account__avatar" />
      <div class="account__heading">
        <h1 class="account__title">Account</h1>
        {memberSince && <p class="account__since">Member since {memberSince}</p>}
      </div>
      <form class="account__signout" method="post" action={logoutAction('/')}>
        <Button type="submit" variant="secondary" label="Sign out" />
      </form>
    </div>

    <div class="account__cards">
      <FormCard title="Profile" level={2}>
        <form class="auth-form" method="post" data-account-name-form>
          {member.loginEmail && (
            <div class="account__field">
              <p class="account__label">Email</p>
              <p class="account__value">{member.loginEmail}</p>
            </div>
          )}
          <div class="auth-form__names">
            <TextField id="account-first-name" label="First name" labelVisible placeholder="First name" autocomplete="given-name" maxlength={50} required size="lg" value={member.firstName} errors />
            <TextField id="account-last-name" label="Last name" labelVisible placeholder="Last name" autocomplete="family-name" maxlength={50} required size="lg" value={member.lastName} errors />
          </div>
          <FormAlert className="auth-form__alert" />
          <Button type="submit" size="form" label="Save changes" busyLabel="Saving…" disabled className="auth-form__submit" />
          <p class="sr-only" aria-live="polite" data-form-status></p>
        </form>
      </FormCard>

      <FormCard title="Password" level={2}>
        <form class="auth-form" method="post" data-account-reset-form>
          <p class="auth-form__intro">We'll email <strong>{member.loginEmail}</strong> a link to set a new password. It works for 3 hours.</p>
          <FormAlert className="auth-form__alert" />
          <Button type="submit" variant="secondary" size="form" label="Send reset link" busyLabel="Sending…" disabled className="auth-form__submit" />
          <p class="sr-only" aria-live="polite" data-form-status></p>
        </form>
      </FormCard>

      <FormCard title="Saved Designs" level={2} className="account__designs">
        <div data-saved-designs data-designs-error={designsFailed ? '' : undefined}>
          {designsFailed ? (
            <p class="ui-design-list__empty">We couldn't load your saved designs. Refresh to try again.</p>
          ) : designs.length === 0 ? (
            <p class="ui-design-list__empty" data-designs-empty>No saved designs yet. <a href="/shop">Find a pair to customize</a></p>
          ) : (
            <>
              <ul class="ui-design-list">
                {designs.map((design) => {
                  const href = `/products/${encodeURIComponent(design.productSlug)}?design=${encodeURIComponent(design.id)}`;
                  // Several designs of one shoe: the base color and date tell their buttons apart.
                  const name = `${design.title || 'design'}${design.baseColor ? `, ${design.baseColor}` : ''}, saved ${savedDate.format(new Date(design.savedAt))}`;
                  return (
                    <li class="ui-design-row" data-design-row data-design-id={design.id} data-product-id={design.productId}>
                      <span class="ui-design-dots" aria-hidden="true">
                        {colorsOf(design).map(({ hex }) => <span style={`--swatch-color: ${hex}`} />)}
                      </span>
                      <div class="ui-design-row__text">
                        <a class="ui-design-row__name" href={href}>{design.title || 'Kix sneaker'}</a>
                        <p class="ui-design-row__meta">
                          {design.baseColor && <>{design.baseColor} · </>}Saved <time datetime={design.savedAt} data-saved-at>{savedDate.format(new Date(design.savedAt))}</time>
                          <span class="sr-only">. Colors: {describe(design)}</span>
                        </p>
                      </div>
                      <div class="ui-design-row__actions" data-design-actions>
                        <a class="ui-button ui-button--quiet ui-design-row__open" href={href} aria-label={`Open ${name}`} data-design-label>Open</a>
                        <button type="button" class="ui-icon-button ui-design-row__delete" aria-label={`Delete ${name}`} data-design-label title="Delete design" data-design-delete>
                          <Trash2 aria-hidden="true" />
                        </button>
                      </div>
                      <div class="ui-design-row__confirm" data-design-confirm hidden>
                        <p class="ui-design-row__ask">Delete this design?</p>
                        <button type="button" class="ui-button ui-button--primary ui-design-row__yes" data-design-yes>Delete</button>
                        <button type="button" class="ui-text-button" data-design-keep>Keep</button>
                      </div>
                      <p class="ui-status-line ui-status-line--error ui-design-row__error" data-design-error></p>
                    </li>
                  );
                })}
              </ul>
              <p class="ui-design-list__empty" data-designs-empty hidden>No saved designs yet. <a href="/shop">Find a pair to customize</a></p>
            </>
          )}
          <p class="sr-only" aria-live="polite" data-designs-status></p>
        </div>
      </FormCard>
    </div>
  </div>
</SiteLayout>

<script>
  import { initAccount } from '../scripts/account';
  import { initSavedDesigns } from '../scripts/saved-designs';
  const root = document.querySelector<HTMLElement>('[data-account]');
  if (root) initAccount(root);
  const designs = document.querySelector<HTMLElement>('[data-saved-designs]');
  if (designs) initSavedDesigns(designs);
</script>
