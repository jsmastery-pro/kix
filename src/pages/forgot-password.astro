---
// Forgot password: Wix emails a link to its own reset page, which returns to /login?reset=done
// (plan 05). @wix/astro has no reset route, so the script calls Send Recovery Email.
import AuthSplit from '../components/AuthSplit.astro';
import Button from '../components/ui/Button.astro';
import FormAlert from '../components/ui/FormAlert.astro';
import FormCard from '../components/ui/FormCard.astro';
import TextField from '../components/ui/TextField.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { DEFAULT_RETURN_TO, safeReturnTo, withReturnTo } from '../scripts/return-to';
import { fetchCurrentMember } from '../wix/members/members';

const returnTo = safeReturnTo(Astro.url.searchParams.get('returnTo'), Astro.url.origin);
Astro.response.headers.set('Cache-Control', 'private, no-store');
if (await fetchCurrentMember()) return Astro.redirect(returnTo ?? DEFAULT_RETURN_TO);
---

<SiteLayout title="Reset password · Kix" description="Get a link to set a new Kix password.">
  <AuthSplit headline={['Sneakers', 'Move culture', 'Forward']} subhead={['Same passion.', 'A more personal experience.']} photo="/images/auth/sign-in-stool.jpg">
    <FormCard title="Reset password" className="auth-split__card">
      <form class="auth-form" method="post" data-reset-form>
        <p class="auth-form__intro" data-reset-hide>Enter your account email and we'll send you a link to set a new password.</p>
        <div data-reset-hide>
          <TextField id="reset-email" label="Email" labelVisible type="email" autocomplete="email" required placeholder="Enter your email" size="lg" errors />
        </div>
        <FormAlert className="auth-form__alert" />
        <div class="auth-form__submit" data-reset-hide>
          <Button type="submit" size="form" label="Send reset link" busyLabel="Sending…" disabled />
        </div>
        <p class="auth-form__switch">Remembered it? <a href={withReturnTo('/login', returnTo)}>Sign in</a></p>
        <p class="sr-only" aria-live="polite" data-form-status></p>
      </form>
    </FormCard>
  </AuthSplit>
</SiteLayout>

<script>
  import { initForgotPassword } from '../scripts/password-reset';
  const form = document.querySelector<HTMLFormElement>('[data-reset-form]');
  if (form) initForgotPassword(form);
</script>
